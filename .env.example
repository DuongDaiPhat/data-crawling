# Khong commit file .env hoac cac khoa bi mat.
ANONYMIZATION_SALT=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Google Sheets: share spreadsheet voi client_email trong service account.
GOOGLE_SERVICE_ACCOUNT_FILE=C:\duong-dan\service-account.json
# Hoac dung GOOGLE_SERVICE_ACCOUNT_JSON={...json...}

# Meta Graph API / Threads API
META_ACCESS_TOKEN=
THREADS_ACCESS_TOKEN=

# Reddit OAuth (chi su dung khi da duoc phep cho muc dich nghien cuu nay)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=edu-social-crawler/0.1 by u/your_reddit_username

